{
  "name": "export-figma-assets",
  "private": true,
  "version": "0.0.1",
  "homepage": "https://github.com/Super1windcloud",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.plugin.config.ts",
    "start": "node --env-file=.env --import tsx server.ts",
    "app": "npm run build && npm run start",
    "download": "node --env-file=.env --import tsx scripts/download-assets.ts"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.131.0",
    "@types/node": "^26.1.1",
    "prettier": "^3.3.1",
    "tsx": "^4.23.1",
    "typescript": "^5.2.2",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "lucide": "^1.26.0"
  }
}
